@layout()


<nav class="absolute top-0 left-0 w-full z-50 flex justify-between items-center px-8 py-6 bg-transparent">

    <a href="/" class="flex items-center">
        <img src="resources\assets\solo_to.png" alt="Logo doortodoor"
            class="h-18 w-auto object-contain hover:scale-105 transition-duration-400">
    </a>

    <p class="text-center mx-7 content-center">About us</p>

    <div class="relative group">
        <button
            class="flex items-center gap-2 text-white bg-white/10 backdrop-blur-md px-5 py-2 rounded-full border border-white/20 hover:bg-white/20 transition-all active:scale-95">
            <span class="font-medium">Menú</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>

        <div
            class="absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-[60] overflow-hidden py-2 border border-white/20">
            <a href="todavia no esta"
                class="block px-4 py-2.5 text-sm text-slate-800 hover:bg-[#12254A] hover:text-white transition-colors">Tu
                perfil</a>
            <a href="todavia no esta"
                class="block px-4 py-2.5 text-sm text-slate-800 hover:bg-[#12254A] hover:text-white transition-colors">Configuración</a>
            <div class="h-[1px] bg-slate-200 my-1"></div>
            <a href="tampoco se puede"
                class="block px-4 py-2.5 text-sm text-red-600 hover:bg-red-500  hover:text-white transition-colors">Cerrar
                Sesión</a>
        </div>
    </div>
</nav>


<div class="grid grid-cols-2 gap-4 grid-flow-col gap-4">

    <div class="fixed row-span-3 row-start-2">
        <div class="flex justify-center items-center rounded-full bg-blue-400/30 h-[calc(100vh)] w-[calc(100vh)]">
            <img src="/resources/assets/boxes.jpg" class="rounded-full w-[300px] h-[300px] translate-x-1/4">
        </div>
    </div>

    <div class="col-start-2 flex justify-center items-center pt-35 grid gap-4">
        <h1 class="text-center text-6xl font-bold font-header text-shadow-lg/30 text-shadow-[#4182b4]">Hello there!</h1>
        <h2 class="text-center text-2xl font-bold font-header text-shadow-lg/30 text-shadow-[#4182b4]">This is your
            profile</h2>

        <div class="py-8 px-14 rounded-4xl bg-white/5 backdrop-filter backdrop-blur-xl bg-opacity-40 grid gap-2">
            <h3 class="text-xl font-bold font-header"> Sandra Guadalupe Mendez</h3>
            <p class="font-bold text-fg-brand font-medium text-blue-600/100 dark:text-sky-400/100">@Sandrita08</p>

            <div class="mt-2 mb-2 flex items-center gap-4 text-white/90">

                <div class="flex items-center gap-2">

                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2">

                        <path
                            d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
                        <circle cx="12" cy="10" r="3" />

                    </svg>

                    <p>Houston, Texas</p>

                </div>

                <div class="flex items-center gap-2">

                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2">

                        <path d="M8 2v4" />
                        <path d="M16 2v4" />
                        <rect width="18" height="18" x="3" y="4" rx="2" />
                        <path d="M3 10h18" />

                    </svg>

                    <p>Joined in 2023</p>

                </div>

            </div>
            <div class="py-4 px-5 rounded-xl bg-white/5 backdrop-filter backdrop-blur-xl bg-opacity-40 grid gap-1">
                <h1 class="font-bold text-l">About me</h1>
                <p>Salvadorenia en USA, q extrania las quesadillas</p>
            </div>

            <button
                class="cursor-pointer bg-[#2467A2] rounded-xl border-1 border-white/50 p-2 px-3 text-lg"><svg
                    xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    class="lucide lucide-pencil-icon lucide-pencil">
                    <path
                        d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" />
                    <path d="m15 5 4 4" />
                </svg>Edit Profile</button>

        </div>
    </div>

</div>

</div>

@end