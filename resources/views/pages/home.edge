@layout()

<style>
  .cajita {
    position: fixed;
    z-index: 4;
    pointer-events: none;
    font-size: 28px;
    filter: drop-shadow(0 4px 8px rgba(0,0,0,0.4));
  }

  .landing-titulo {
    background: linear-gradient(90deg,
      #ffffff 0%,
      #ffffff 35%,
      #4182b4 48%,
      #DFEEF3 52%,
      #ffffff 65%,
      #ffffff 100%);
    background-size: 100% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }


  .landing-linea {
    height: 2px;
    width: 0%;
    background: linear-gradient(90deg, transparent, #4182b4, #DFEEF3, #4182b4, transparent);
    box-shadow: 0 0 12px #4182b4;
    margin: 0 auto;
    border-radius: 999px;
  }

  @keyframes scrollBounce {
    0%, 100% { transform: rotate(45deg) translateY(0); opacity: 0.4; }
    50% { transform: rotate(45deg) translateY(6px); opacity: 1; }
  }

</style>

<div class="relative bg-[#12254A] min-h-screen w-full overflow-x-hidden">
  <video autoplay loop muted src="/resources/assets/video2background.mp4"
    class="fixed top-0 left-0 w-full h-full object-cover z-0">
  </video>

  <nav class="absolute left-0 w-full z-50 flex justify-between items-center px-8 py-6 bg-transparent">
    <a href="/" class="flex items-center">
      <img src="resources/assets/solo_to.png" alt="Logo doortodoor" class="h-18 w-auto object-contain hover:scale-105 transition-all duration-300">
    </a>

    <div class="relative group" style="z-index:9999">
      <button
        class="flex items-center gap-2 text-white bg-white/10 backdrop-blur-md px-5 py-2 rounded-full border border-white/20 hover:bg-white/20 transition-all active:scale-95">
        <span class="font-medium">Menú</span>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <div
        class="absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-[9999] overflow-hidden py-2 border border-white/20">
        <a href="profile" class="block px-4 py-2.5 text-sm text-slate-800 hover:bg-[#0D4576] hover:text-white transition-colors">Your profile</a>
        <a href="#" class="block px-4 py-2.5 text-sm text-slate-800 font-medium hover:bg-[#0D4576] hover:text-white transition-colors">Settings</a>
        <div class="h-[1px] bg-slate-200 my-1"></div>
        <a href="#" class="block px-4 py-2.5 text-sm text-[#12254A] hover:bg-[#12254A] hover:text-white transition-colors">Sign out</a>
      </div>
    </div>
  </nav>

  <main class="relative z-10 flex flex-col items-center justify-center h-screen text-white text-center">

    <h1 id="landing-titulo" class="landing-titulo font-bold text-5xl md:text-5xl drop-shadow-2xl mb-6 max-w-4xl leading-tight">
      El Salvador is knocking your door
    </h1>

    <div class="landing-linea mb-8" id="landing-linea"></div>

    <p id="landing-sub" class="text-lg md:text-2xl opacity-0 drop-shadow-lg font-light tracking-wide max-w-xl">
      Making every delivery feel <span class="font-bold text-[#4182b4]">personal</span>
    </p>

 <div class="flex">
<a href="/log_in"
              class="flex items-center justify-center border rounded-full w-42 h-10 bg-gradient-to-r from-[#4182B4] via-[#2467A2] to-[#0D4576] cursor-pointer hover:bg-gradient-to-r hover:from-[#2467A2] hover:via-[#4182B4] hover:to-[#2467A2] transition-all duration-300 m-4 no-underline">

              <p class="drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)] hover:drop-shadow-[0_0_2px_#fff] text-white">
                Log in
              </p>
            </a>

<a href="/register"
              class="flex items-center justify-center border rounded-full w-42 h-10 bg-gradient-to-r from-[#4182B4] via-[#2467A2] to-[#0D4576] cursor-pointer hover:bg-gradient-to-r hover:from-[#2467A2] hover:via-[#4182B4] hover:to-[#2467A2] transition-all duration-300 m-4 no-underline">

              <p class="drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)] hover:drop-shadow-[0_0_2px_#fff] text-white">
                Register
              </p>
            </a>
            </div>
  </main>

</div>

@end
