@layout()

<div class="bg-[#0D4576] rounded-md mx-24 mt-4 ">

  <div class=" flex flex-col items-center justify-center ">


    <p class="text-center text-white drop-shadow-[0_0_10px_rgba(255,255,255,0.8)] text-4xl font-semibold px-46 py-4">
      With which agency do you wish to send your parcel today?
    </p>

    <div class=" flex justify-self-center h-1 w-100 bg-linear-to-r from-[#787880] to-[#4182B4]"></div>
  </div>



