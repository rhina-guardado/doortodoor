<body class="bg-[#0D4576] border rounded-md mx-24 my-4">





  <div class=" flex flex-col items-center justify-center border border-color-[#FFFFF]">

    <p class="text-center bg-blue-400 text-white drop-shadow-[0_0_10px_rgba(255,255,255,0.8)] text-4xl font-semibold px-46 py-4">
      With which agency do you wish to send your parcel today?
    </p>

    <div class=" flex justify-self-center border h-2 w-100 bg-blue-500 "></div>
</div>



<div class=" mt-22 py-1 flex flex-col items-center border border-color[#FFFFF]">
      <input class="p-1 my-4 border rounded-2xl w-182 from-[#787880] bg-[#787880]/60 " placeholder="Search">

      <button class="border rounded-full w-36 h-12 bg-[#4182B4] ">
        <p class=" drop-shadow-[0_1px_1px_#ffffff] hover:drop-shadow-[0_0_5px_#fff] ">Compare</p>
      </button>


      </div>


