@layout()

<div class="relative bg-[#12254A] min-h-screen w-full overflow-y-auto">
  <video autoplay loop muted src="/resources/assets/video2background.mp4"
    class="fixed inset-0 w-full h-full object-cover z-0">
  </video>

  <nav class="absolute top-0 left-0 w-full z-50 flex justify-between items-center px-8 py-6 bg-transparent">

    <a href="/welcome" class="flex items-center">
      <img src="resources\assets\solo_to.png" alt="Logo doortodoor"
        class="h-18 w-auto object-contain hover:scale-105 transition-duration-400">
    </a>

    <div class="relative group">
      <button
        class="flex items-center gap-2 text-white bg-white/10 backdrop-blur-md px-5 py-2 rounded-full border border-white/20 hover:bg-white/20 transition-all active:scale-95">
        <span class="font-medium">Menu</span>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <div
        class="absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-[60] overflow-hidden py-2 border border-white/20">
        <a href="profile"
          class="block px-4 py-2.5 text-sm text-slate-800 hover:bg-[#12254A] hover:text-white transition-colors">Your
          profile</a>
        <a href="todavia no esta"
          class="block px-4 py-2.5 text-sm text-slate-800 hover:bg-[#12254A] hover:text-white transition-colors">Settings</a>
        <div class="h-[1px] bg-slate-200 my-1"></div>
        <a href="tampoco se puede"
          class="block px-4 py-2.5 text-sm text-red-600 hover:bg-red-500  hover:text-white transition-colors">Sign
          out</a>
      </div>
    </div>
  </nav>

  <section class="relative z-10 min-h-screen  text-white p-8 font-sans">

    <div class="max-w-6xl pt-36 mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-start">


      <div class="space-y-12">

        <div class="space-y-4">
          <h2 class="text-3xl font-bold agency-card">Location</h2>
          <p class="text-gray-300 text-sm leading-relaxed agency-card">
            The most prominent branches in El Salvador are the GlobalBox Building in Antiguo Cuscatlán (Urbanización y
            Blvd Santa Elena, Avenida Apaneca, East) and the new GlobalBox Express Héroes location in the Olímpica
            District (Av. Olímpica & Alameda Manuel Enrique Araujo) in San Salvador. There are also service points in
            Soyapango and Sonsonate, located in Plaza Mundo and 3rd North Avenue, respectively. 
          </p>
        </div>


        <div class="relative group w-full agency-card">
          <div class="-inset-1 rounded-lg blur opacity-75"></div>
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15504.67407330174!2d-89.25315476716787!3d13.708241383485259!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f63301ec4aaa4c1%3A0x67bf47eb58044d83!2sEl%20Escal%C3%B3n%2C%20San%20Salvador!5e0!3m2!1ses-419!2ssv!4v1778598934073!5m2!1ses-419!2ssv"
            width="550" height="450" style="border:0;" allowfullscreen="" loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>

        <div class="space-y-4 agency-card">
          <h2 class="text-3xl font-bold">Coverage</h2>
          <p class="text-gray-300 text-sm leading-relaxed">
            Shipments to more than 220 countries and territories, over 115,000 service points worldwide and global
            network with 2,300+ daily flights and 34,600 vehicles
          </p>
        </div>


        <div class="space-y-4 agency-card">
          <h2 class="text-3xl font-bold">Prices</h2>
          <p class="text-gray-300 text-sm leading-relaxed">
            Prices may vary depending on weight, size, and type of shipment, so it is necessary to provide these details
            to get a quote.
          </p>
        </div>
      </div>


      <div class="flex flex-col items-center">

        <div class="relative mb-6">

          <div class="relative mb-6">
            <div class="absolute -inset-4 bg-blue-600/40 rounded-[2rem] blur-xl"></div>

            <div
              class="relative overflow-hidden rounded-[2rem] border border-blue-400/30 w-80resources/views/pages/ConectExpress.edge h-48 flex items-center justify-center bg-[#4a2418]">
              <img src="resources\assets\globalbox.png" alt="GlobalBoxLogo" class="w-full h-full object-cover">
            </div>
          </div>
        </div>

        <h1 class="text-5xl font-black mb-8 tracking-tighter titulo-principal  text-white drop-shadow-[0_0_10px_rgba(255,255,255,0.8)] text-3xl font-semibold pointer-events-none ">GlobalBox Express</h1>


        <div class="flex gap-12 mb-12">
          <a href="chat">
            <button
              class="px-10 py-1  bg-[#1d3557] rounded-full bg-gradient-to-r from-[#0D4576] to-[#4182B4] hover:from-[#4182B4] hover:to-[#0D4576] transition-all duration-300 active:scale-95"">
              Chat
            </button>
          </a>
          <a href="track">
            <button
              class="px-10 py-1  bg-[#1d3557] rounded-full bg-gradient-to-r from-[#0D4576] to-[#4182B4] hover:from-[#4182B4] hover:to-[#0D4576] transition-all duration-300 active:scale-95">Track</button>
          </a>
        </div>


        <div class="relative w-full pl-8 border-l-2 border-gray-600 space-y-10">


          <div class="relative">
            <div class="absolute -left-[41px] top-1 w-4 h-4 bg-purple-600 rounded-full border-4 border-[#0a192f]"></div>
            <h3 class="text-2xl font-bold mb-2">Services</h3>
            <p class="text-gray-300 text-sm agency-card">GlobalBox offers services such as GlobalBox Express for urgent shipments,
              GlobalBox Global Forwarding and GlobalBox Freight for cargo transportation (air, land, sea), GlobalBox
              Supply Chain for supply chain management and logistics services, and GlobalBox eCommerce Solutions for
              e-commerce solutions, in addition to general mail and parcel services.</p>
          </div>


          <div class="relative agency-card">
            <div class="absolute -left-[41px] top-1 w-4 h-4 bg-purple-600 rounded-full border-4 border-[#0a192f]"></div>
            <h3 class="text-2xl font-bold mb-2">Schedule</h3>
            <p class="text-gray-300 text-sm">Monday to Friday: 8:00 a.m. - 6:00 p.m.<br>Saturday: 9:00 a.m. - 12:00
              p.m.<br>Sunday: Closed</p>
          </div>


          <div class="relative agency-card">
            <div class="absolute -left-[41px] top-1 w-4 h-4 bg-purple-600 rounded-full border-4 border-[#0a192f]"></div>
            <h3 class="text-2xl font-bold mb-2">Phone</h3>
            <p class="text-gray-300 text-sm">(+503) 2248- 8998</p>
          </div>

          <div class="relative agency-card">
            <div class="absolute -left-[41px] top-1 w-4 h-4 bg-purple-600 rounded-full border-4 border-[#0a192f]"></div>
            <h3 class="text-2xl font-bold mb-2">Website</h3>
            <a href="#" class="text-blue-400 text-xs underline break-all">https://www.dhl.com/sv-es/home.html</a>
          </div>
        </div>
      </div>
    </div>

    <section class="relative agency-card z-10 py-16 px-8 text-white font-sans">
      <div class="max-w-6xl mx-auto">

        <h2 class="text-4xl font-bold text-center mb-16 tracking-tight">Products</h2>


        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">


          <div class="border border-white/20 rounded-lg overflow-hidden bg-white/5 backdrop-blur-sm min-h-[400px]">

            <div class="bg-gradient-to-b from-[#1D4D92]/50 to-transparent py-8 border-b border-white/10">
              <h3 class="text-xl font-bold text-center tracking-wide">Allowed</h3>
            </div>

            <div class="p-8 space-y-2 text-center">
              <p class="text-lg text-gray-200">Documents</p>
              <p class="text-lg text-gray-200">Clothing and textiles</p>
              <p class="text-lg text-gray-200">Pharmaceutical products</p>
              <p class="text-lg text-gray-200">Bread</p>
              <p class="text-lg text-gray-200">Cheese</p>
              <p class="text-lg text-gray-200">Ground corn</p>
              <p class="text-lg text-gray-200">Tortillas</p>
              <p class="text-lg text-gray-200">Dietary supplements</p>
              <p class="text-lg text-gray-200">Sauces</p>
              <p class="text-lg text-gray-200">Tea</p>
              <p class="text-lg text-gray-200">Dried shrimp</p>
            </div>
          </div>


          <div class="border border-white/20 rounded-lg overflow-hidden bg-white/5 backdrop-blur-sm min-h-[400px]">

            <div class="bg-gradient-to-b from-[#1D4D92]/50 to-transparent py-8 border-b border-white/10">
              <h3 class="text-xl font-bold text-center tracking-wide">Not Allowed</h3>
            </div>

            <div class="p-8 space-y-2 text-center">
              <p class="text-lg text-gray-200">Illegal items</p>
              <p class="text-lg text-gray-200">Weapons</p>
              <p class="text-lg text-gray-200">Ammunition</p>
              <p class="text-lg text-gray-200">Alive animals</p>
              <p class="text-lg text-gray-200">Physical cash</p>
              <p class="text-lg text-gray-200">Dangerous or corrosive goods:</p>
              <p class="text-lg text-gray-200">Toxic substances</p>
              <p class="text-lg text-gray-200">Perfumes</p>
              <p class="text-lg text-gray-200">Alcohols without approval</p>
              <p class="text-lg text-gray-200">Watches</p>
              <p class="text-lg text-gray-200">Cosmetics</p>
              <p class="text-lg text-gray-200">Perishable food</p>
              <p class="text-lg text-gray-200">High-value jewelry</p>
            </div>
          </div>

        </div>


        <div class="mt-16 text-center">
          <p class="text-gray-400 text-sm italic">
            Note: Please check permits and documentation to avoid issues at customs.
          </p>
        </div>
      </div>
    </section>
  </section>













  <footer
    class="relative z-10 flex flex-row items-center justify-around bg-gradient-to-r from-[#12254A]/70 via-[#0D4576]/30 to-[#12254A]/70">

    <div class="flex-shrink-0">
      <img src="resources/assets/solo_to.png"
        class="h-48 w-48 rounded-full  my-6 object-cover shadow-[0_10px_10px_0_rgba(0,0,0,0.3)]">
    </div>

    <div class="flex flex-row items-start gap-16 p-2">


      <div class="flex flex-col items-center gap-3">
        <p class="pb-4 font-bold text-lg text-white text-shadow-lg/20">Our Team</p>
        <div class="flex flex-col items-center gap-2 text-white">
          <a href="about_us.com" target="_blank"
            class="drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)] hover:underline hover:text-white">About Us</a>
          <a href="privacy_policy.com" target="_blank"
            class=" drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)] hover:underline hover:text-white">Privacy Policy</a>
          <a href="contact_us.com" target="_blank"
            class=" drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)] hover:underline hover:text-white">Contact Us</a>
        </div>
      </div>


      <div class="flex flex-col items-center gap-3">
        <p class="pb-4 font-bold text-lg text-white text-shadow-lg/20 ">Agencias</p>
        <div class="flex flex-row gap-10 text-white">
          <div class="flex flex-col text-center gap-2">
            <a href="Fidix" target="_blank"
              class=" drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)] hover:underline hover:text-white">FIDIX</a>
            <a href="Enviomundo" target="_blank"
              class=" drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)] hover:underline hover:text-white">EnvíoMundo</a>
            <a href="AY" target="_blank"
              class=" drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)] hover:underline hover:text-white">AY</a>
          </div>
          <div class="flex flex-col text-center gap-2">
            <a href="CargoRapido" target="_blank"
              class=" drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)] hover:underline hover:text-white">CargoRápido</a>
            <a href="ConectExpress" target="_blank"
              class=" drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)] hover:underline hover:text-white">ConnectExpress</a>
            <a href="GlobalBox" target="_blank"
              class=" drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)] hover:underline hover:text-white">GlobalBox
              Express</a>
          </div>
        </div>
      </div>


      <div class="flex flex-col items-center gap-3">
        <p class="pb-4 font-bold text-lg text-white text-shadow-lg/20">Follow Us</p>
        <div class="flex flex-row gap-4">
          <a href="facebook.com" target="_blank" class="transition-transform hover:scale-110">
            <img src="resources/assets/facebook.png" class="h-10 w-10">
          </a>
          <a href="instagram.com" target="_blank" class="transition-transform hover:scale-110">
            <img src="resources/assets/insta.png" class="h-10 w-10">
          </a>
          <a href="twitter.com" target="_blank" class="transition-transform hover:scale-110">
            <img src="resources/assets/twitter.png" class="h-10 w-10">
          </a>
        </div>
      </div>

    </div>
  </footer>


  @end
