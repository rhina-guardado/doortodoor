</head>

<body>
    <section class="h-screen flex p-6 bg-gray-100">
        <div class="bg-blue-200 w-3/12 p-6 rounded-3xl shadow-lg flex flex-col items-center">
            <h3 class="text-2xl mb-8 self-start">Chat en línea</h3>
            <div class="flex overflow-auto w-full mb-8">


                <div class="flex flex-col items-center self-center text-center mr-4">
                    <div class="relative"> <img src="resources\assets\cargorapido.jpg"
                            class="w-12 h-12 rounded-full object-cover">
                        <span
                            class="absolute bottom-1 right-1 bg-green-500 w-4 h-4 rounded-full border-2 border-blue-200"></span>
                    </div>
