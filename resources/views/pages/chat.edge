<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ChatDoor</title>
  <link href="https://unpkg.com/tailwindcss@^2/dist/tailwind.min.css" rel="stylesheet">
  <link rel="stylesheet" href="chat.css">
</head>

<nav
      class="top-0 left-0 w-full z-50  flex justify-between items-center px-8 py-6 bg-gradient-to-right from-[#12254A]/20 via-[#0D4576]/20 to-[#12254A]/20 mb-26">

      <a href="/" class="flex items-center">
        <img src="resources\assets\solo_to.png" alt="Logo doortodoor"
          class="h-12 w-12 rounded-full hover:scale-105 transition-duration-400 object-cover shadow-[0_10px_8px_0_rgba(0,0,0,0.3)]">
      </a>

      <a href="home.com" target="_blank"
        class=" drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)] hover:underline hover:text-white">Home</a>


      <div class="relative group">
        <button
          class="flex items-center cursor-pointer gap-2 text-white bg-white/10 backdrop-blur-md px-5 py-2 rounded-full border border-white/20 hover:bg-white/20 transition-all active:scale-95">
          <span class="font-medium">Menu</span>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <div
          class="absolute right-0 mt-3 w-56 bg-white/70 rounded-2xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-[60] overflow-hidden py-2 border border-white/20">
          <a href="todavia no esta"
            class="block px-4 py-2.5 text-sm font-medium text-slate-800 hover:bg-[#0D4576] hover:text-white transition-colors">Your
            profile</a>
          <a href="todavia no esta"
            class="block px-4 py-2.5 text-sm text-slate-800 font-medium hover:bg-[#0D4576]  hover:text-white transition-colors">Settings</a>
          <div class="h-[1px] bg-slate-200 my-1"></div>
          <a href="tampoco se puede"
            class="block px-4 py-2.5 text-sm font-medium text-[#12254A] hover:bg-[#12254A] hover:text-white transition-colors">Sign
            out</a>
        </div>
      </div>
    </nav>

<body class="font-sans">
  <section class="h-screen flex p-6">

    <!-- Sidebar contactos -->
    <div class="bg-blue-200 w-3/12 p-6 rounded-3xl shadow-lg flex flex-col">
      <h3 class="text-2xl mb-6 font-semibold">ChatDoor</h3>
      <div class="flex overflow-x-auto space-x-4 mb-6">
        <div class="flex flex-col items-center">
          <div class="relative">
            <img src="resources\assets\cargorapido.png" class="w-12 h-12 rounded-full object-cover">
            <span class="absolute bottom-1 right-1 bg-green-500 w-3 h-3 rounded-full border-2 border-blue-200"></span>
          </div>
          <small class="mt-2 font-semibold text-gray-700">Cargo Express</small>
        </div>
      </div>

      <!-- Lista de chats recientes -->
      <div class="overflow-y-auto space-y-4">
        <div class="flex bg-gray-100 rounded-xl p-3 cursor-pointer hover:bg-gray-200 transition">
          <img src="resources\assets\cargorapido.png" class="rounded-full w-12 mr-4">
          <div class="flex-1">
            <div class="flex justify-between">
              <p class="font-semibold">Cargo Express</p>
              <small class="text-gray-500">9:55 am</small>
            </div>
            <small class="block truncate text-gray-600">Último mensaje...</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Área de conversación -->
    <div class="flex-1 bg-white ml-4 rounded-3xl shadow-sm border border-gray-300 flex flex-col">

      <!-- Encabezado -->
      <div class="p-4 border-b border-gray-200 flex items-center">
        <img src="resources\assets\cargorapido.png" class="w-10 h-10 rounded-full mr-3">
        <div>
          <p class="font-semibold">Cargo Express</p>
          <small class="text-gray-500">En línea</small>
        </div>
      </div>

      <!-- Mensajes -->
      <div id="chatArea" class="flex-1 p-6 overflow-y-auto space-y-4">
        <!-- Mensaje recibido -->
        <div class="flex items-start">
          <img src="resources\assets\cargorapido.png" class="w-10 h-10 rounded-full mr-3">
          <div class="bg-gray-200 p-3 rounded-xl max-w-xs">
            <p>Hola, ¿cómo estás?</p>
            <small class="text-gray-500 text-xs">9:55 am</small>
          </div>
        </div>
        <!-- Mensaje enviado -->
        <div class="flex items-start justify-end">
          <div class="bg-blue-500 text-white p-3 rounded-xl max-w-xs">
            <p>¡Todo bien! ¿Y tú?</p>
            <small class="text-gray-200 text-xs">9:56 am</small>
          </div>
        </div>
      </div>

      <!-- Input -->
      <div class="p-4 border-t border-gray-200 flex items-center">
        <input id="messageInput" type="text" placeholder="Escribe un mensaje..." class="flex-1 p-3 rounded-xl border border-gray-300 focus:outline-none">
        <button id="sendBtn" class="ml-3 bg-blue-500 text-white px-4 py-2 rounded-xl hover:bg-blue-600 transition">Enviar</button>
      </div>
    </div>
  </section>

  <script>
  const chatArea = document.getElementById('chatArea');
  const messageInput = document.getElementById('messageInput');
  const sendBtn = document.getElementById('sendBtn');

  function enviarMensaje(texto) {
    const msgDiv = document.createElement('div');
    msgDiv.className = "flex items-start justify-end";
    msgDiv.innerHTML = `
      <div class="bg-blue-500 text-white p-3 rounded-xl max-w-xs">
        <p>${texto}</p>
        <small class="text-gray-200 text-xs">Ahora</small>
      </div>
    `;
    chatArea.appendChild(msgDiv);
    chatArea.scrollTop = chatArea.scrollHeight;
  }

  function respuestaAutomatica(userText) {
    let respuesta = "¡Gracias por tu mensaje! 😊"; // respuesta por defecto

    // Aquí defines tus "simulaciones"
    if (userText.toLowerCase().includes("okey estaré pendiente")) {
      respuesta = "Okey a la orden, le aviso cuando esté afuera";
    } else if (userText.toLowerCase().includes("ya esta cerca?")) {
      respuesta = "¡Sí estoy a dos calles de mi destino!";
    }

    const replyDiv = document.createElement('div');
    replyDiv.className = "flex items-start";
    replyDiv.innerHTML = `
      <img src="resources/assets/cargorapido.png" class="w-10 h-10 rounded-full mr-3 object-cover">
      <div class="bg-gray-200 p-3 rounded-xl max-w-xs">
        <p>${respuesta}</p>
        <small class="text-gray-500 text-xs">Ahora</small>
      </div>
    `;
    chatArea.appendChild(replyDiv);
    chatArea.scrollTop = chatArea.scrollHeight;
  }

  sendBtn.addEventListener('click', () => {
    const text = messageInput.value.trim();
    if (text !== "") {
      enviarMensaje(text);
      messageInput.value = "";
      setTimeout(() => respuestaAutomatica(text), 1000);
    }
  });

  messageInput.addEventListener("keypress", (e) => {
    if (e.key === "Enter") sendBtn.click();
  });
</script>


</body>

</html>

