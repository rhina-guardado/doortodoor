@layout()

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fira+Sans+Condensed:wght@400;600;700&family=Inter:wght@300;400;500&display=swap');

  .chat-wrapper {
    font-family: 'Inter', sans-serif;
    height: 100vh;
    background: #0a0f1e;
    background-image:
      radial-gradient(ellipse at 20% 50%, rgba(13, 69, 118, 0.25) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 20%, rgba(18, 37, 74, 0.4) 0%, transparent 50%),
      radial-gradient(ellipse at 60% 80%, rgba(36, 103, 162, 0.15) 0%, transparent 50%);
    position: relative;
    overflow: hidden;
  }

  /* Fondo animado con partículas */
  .chat-wrapper::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 20% 30%, rgba(65, 130, 180, 0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 80% 70%, rgba(65, 130, 180, 0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 50% 50%, rgba(223, 239, 243, 0.2) 0%, transparent 100%),
      radial-gradient(1px 1px at 10% 80%, rgba(65, 130, 180, 0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 90% 10%, rgba(65, 130, 180, 0.2) 0%, transparent 100%);
    background-size: 400px 400px;
    animation: drift 20s linear infinite;
    pointer-events: none;
    z-index: 0;
  }

  @keyframes drift {
    0% { transform: translate(0, 0); }
    25% { transform: translate(-10px, 15px); }
    50% { transform: translate(10px, -10px); }
    75% { transform: translate(-5px, 20px); }
    100% { transform: translate(0, 0); }
  }

  /* Grid sutil de fondo */
  .chat-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(65, 130, 180, 0.04) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(65, 130, 180, 0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  .chat-inner {
    position: relative;
    z-index: 1;
    height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* NAV */
  .chat-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 32px;
    background: rgba(10, 15, 30, 0.7);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(65, 130, 180, 0.15);
    z-index: 99999;
  }

  .chat-nav img {
    height: 44px;
    width: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(65, 130, 180, 0.4);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .chat-nav img:hover {
    transform: scale(1.08);
    border-color: #4182b4;
  }

  .chat-nav a.nav-link {
    color: rgba(223, 239, 243, 0.7);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s;
    font-weight: 500;
  }

  .chat-nav a.nav-link:hover {
    color: #DFEEF3;
  }

  .menu-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    color: white;
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(12px);
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.12);
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 0.9rem;
    font-family: 'Inter', sans-serif;
  }

  .menu-btn:hover { background: rgba(255,255,255,0.12); }

  .menu-dropdown {
    position: absolute;
    right: 0;
    margin-top: 12px;
    width: 220px;
    background: rgba(15, 25, 50, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 16px;
    border: 1px solid rgba(65, 130, 180, 0.2);
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    overflow: hidden;
    padding: 8px 0;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 99999;
  }

  .menu-wrapper:hover .menu-dropdown {
    opacity: 1;
    visibility: visible;
  }

  .menu-dropdown a {
    display: block;
    padding: 10px 16px;
    font-size: 0.875rem;
    color: rgba(223, 239, 243, 0.8);
    text-decoration: none;
    transition: all 0.2s;
    font-weight: 500;
  }

  .menu-dropdown a:hover {
    background: rgba(65, 130, 180, 0.2);
    color: #DFEEF3;
  }

  .menu-divider {
    height: 1px;
    background: rgba(65, 130, 180, 0.15);
    margin: 4px 0;
  }

  /* CONTENIDO PRINCIPAL */
  .chat-body {
    flex: 1;
    display: flex;
    padding: 20px 24px;
    gap: 16px;
    overflow: hidden;
  }

  /* SIDEBAR */
  .sidebar {
    width: 280px;
    background: rgba(13, 69, 118, 0.15);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(65, 130, 180, 0.2);
    border-radius: 24px;
    display: flex;
    flex-direction: column;
    padding: 20px;
    gap: 16px;
    flex-shrink: 0;
  }

  .sidebar-title {
    font-family: 'Fira Sans Condensed', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: #DFEEF3;
    letter-spacing: 0.02em;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(65, 130, 180, 0.2);
  }

  /* Stories / avatares activos */
  .stories {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .stories::-webkit-scrollbar { display: none; }

  .story-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .story-avatar {
    position: relative;
    width: 48px;
    height: 48px;
  }

  .story-avatar img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #4182b4;
  }

  .online-dot {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 11px;
    height: 11px;
    background: #22c55e;
    border-radius: 50%;
    border: 2px solid #0a0f1e;
    animation: pulse-dot 2s infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.4); }
    50% { box-shadow: 0 0 0 4px rgba(34, 197, 94, 0); }
  }

  .story-name {
    font-size: 0.65rem;
    color: rgba(223, 239, 243, 0.6);
    font-weight: 500;
    text-align: center;
    max-width: 52px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Lista de chats */
  .chat-list {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .chat-list::-webkit-scrollbar { width: 4px; }
  .chat-list::-webkit-scrollbar-thumb { background: rgba(65, 130, 180, 0.3); border-radius: 10px; }
  .chat-list::-webkit-scrollbar-track { background: transparent; }

  .chat-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .chat-item:hover, .chat-item.active {
    background: rgba(65, 130, 180, 0.15);
    border-color: rgba(65, 130, 180, 0.25);
  }

  .chat-item img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(65, 130, 180, 0.3);
    flex-shrink: 0;
  }

  .chat-item-info { flex: 1; min-width: 0; }

  .chat-item-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
  }

  .chat-item-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: #DFEEF3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chat-item-time {
    font-size: 0.7rem;
    color: rgba(223, 239, 243, 0.4);
    flex-shrink: 0;
  }

  .chat-item-preview {
    font-size: 0.75rem;
    color: rgba(223, 239, 243, 0.45);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ÁREA DE CONVERSACIÓN */
  .conversation {
    flex: 1;
    background: rgba(10, 15, 30, 0.5);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(65, 130, 180, 0.2);
    border-radius: 24px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Header conversación */
  .conv-header {
    padding: 16px 20px;
    border-bottom: 1px solid rgba(65, 130, 180, 0.15);
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(13, 69, 118, 0.1);
  }

  .conv-header img {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(65, 130, 180, 0.5);
  }

  .conv-header-name {
    font-weight: 600;
    color: #DFEEF3;
    font-size: 0.95rem;
  }

  .conv-header-status {
    font-size: 0.75rem;
    color: #22c55e;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .conv-header-status::before {
    content: '';
    width: 6px;
    height: 6px;
    background: #22c55e;
    border-radius: 50%;
    display: inline-block;
    animation: pulse-dot 2s infinite;
  }

  /* Mensajes */
  #chatArea {
    flex: 1;
    padding: 24px 20px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #chatArea::-webkit-scrollbar { width: 4px; }
  #chatArea::-webkit-scrollbar-thumb { background: rgba(65, 130, 180, 0.3); border-radius: 10px; }
  #chatArea::-webkit-scrollbar-track { background: transparent; }

  .msg-received { display: flex; align-items: flex-end; gap: 8px; }
  .msg-sent { display: flex; align-items: flex-end; justify-content: flex-end; }

  .msg-received img {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid rgba(65, 130, 180, 0.4);
  }

  .bubble {
    max-width: 65%;
    padding: 10px 14px;
    border-radius: 18px;
    font-size: 0.875rem;
    line-height: 1.5;
    animation: bubbleIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes bubbleIn {
    from { opacity: 0; transform: scale(0.85) translateY(8px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  .bubble-received {
    background: rgba(18, 37, 74, 0.8);
    border: 1px solid rgba(65, 130, 180, 0.2);
    color: #DFEEF3;
    border-bottom-left-radius: 4px;
  }

  .bubble-sent {
    background: linear-gradient(135deg, #2467A2, #0D4576);
    color: #DFEEF3;
    border-bottom-right-radius: 4px;
    box-shadow: 0 4px 15px rgba(13, 69, 118, 0.4);
  }

  .bubble-time {
    font-size: 0.65rem;
    opacity: 0.5;
    margin-top: 4px;
    display: block;
  }

  /* Indicador escribiendo */
  .typing-indicator {
    display: none;
    align-items: flex-end;
    gap: 8px;
  }

  .typing-indicator.show { display: flex; }

  .typing-bubble {
    background: rgba(18, 37, 74, 0.8);
    border: 1px solid rgba(65, 130, 180, 0.2);
    border-radius: 18px;
    border-bottom-left-radius: 4px;
    padding: 12px 16px;
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .typing-dot {
    width: 6px;
    height: 6px;
    background: rgba(65, 130, 180, 0.7);
    border-radius: 50%;
    animation: typing 1.4s infinite;
  }

  .typing-dot:nth-child(2) { animation-delay: 0.2s; }
  .typing-dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes typing {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-6px); opacity: 1; }
  }

  /* Input área */
  .input-area {
    padding: 16px 20px;
    border-top: 1px solid rgba(65, 130, 180, 0.15);
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(10, 15, 30, 0.3);
  }

  #messageInput {
    flex: 1;
    background: rgba(13, 69, 118, 0.15);
    border: 1px solid rgba(65, 130, 180, 0.25);
    border-radius: 999px;
    padding: 12px 20px;
    color: #DFEEF3;
    font-size: 0.875rem;
    font-family: 'Inter', sans-serif;
    outline: none;
    transition: all 0.2s ease;
  }

  #messageInput::placeholder { color: rgba(223, 239, 243, 0.3); }

  #messageInput:focus {
    border-color: rgba(65, 130, 180, 0.6);
    background: rgba(13, 69, 118, 0.25);
    box-shadow: 0 0 0 3px rgba(65, 130, 180, 0.1);
  }

  #sendBtn {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, #4182b4, #0D4576);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    flex-shrink: 0;
    box-shadow: 0 4px 15px rgba(13, 69, 118, 0.4);
  }

  #sendBtn:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 20px rgba(65, 130, 180, 0.4);
  }

  #sendBtn:active { transform: scale(0.95); }

  #sendBtn svg {
    width: 18px;
    height: 18px;
    color: white;
    transform: translateX(1px);
  }
</style>

<div class="chat-wrapper">
  <div class="chat-inner">

    
    <nav class="chat-nav">
      <a href="/agencias">
        <img src="/resources/assets/solo_to.png" alt="Logo doortodoor">
      </a>

      <div class="menu-wrapper" style="position:relative">
        <button class="menu-btn">
          <span>Menu</span>
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <div class="menu-dropdown">
          <a href="profile">Your profile</a>
          <a href="#">Settings</a>
          <div class="menu-divider"></div>
          <a href="#" style="color: rgba(223,239,243,0.5)">Sign out</a>
        </div>
      </div>
    </nav>

    
    <div class="chat-body">

     
      <div class="sidebar agency-card">
        <div class="sidebar-title">ChatDoor</div>

    
        <div class="stories">
          <div class="story-item">
            <div class="story-avatar">
              <img src="/resources/assets/cargorapido.png" alt="Cargo">
              <span class="online-dot"></span>
            </div>
            <span class="story-name">Cargo</span>
          </div>
          <div class="story-item">
            <div class="story-avatar">
              <img src="/resources/assets/fidix.png" alt="FIDIX">
            </div>
            <span class="story-name">FIDIX</span>
          </div>
          <div class="story-item">
            <div class="story-avatar">
              <img src="/resources/assets/globalbox.png" alt="Global">
            </div>
            <span class="story-name">GlobalBox</span>
          </div>
        </div>

    
        <div class="chat-list agency-card">
          <div class="chat-item active">
            <img src="/resources/assets/cargorapido.png" alt="Cargo Express">
            <div class="chat-item-info">
              <div class="chat-item-top">
                <span class="chat-item-name">Cargo Rápido</span>
                <span class="chat-item-time">9:55 am</span>
              </div>
              <div class="chat-item-preview">Last message...</div>
            </div>
          </div>

          <div class="chat-item">
            <img src="/resources/assets/fidix.png" alt="FIDIX">
            <div class="chat-item-info">
              <div class="chat-item-top">
                <span class="chat-item-name">FIDIX</span>
                <span class="chat-item-time">Yesterday</span>
              </div>
              <div class="chat-item-preview">Your packet has arrived to the destination</div>
            </div>
          </div>

          <div class="chat-item">
            <img src="/resources/assets/globalbox.png" alt="GlobalBox">
            <div class="chat-item-info">
              <div class="chat-item-top">
                <span class="chat-item-name">GlobalBox Express</span>
                <span class="chat-item-time">Mon</span>
              </div>
              <div class="chat-item-preview">Need something else?</div>
            </div>
          </div>
        </div>
      </div>

   
      <div class="conversation">

       
        <div class="conv-header">
          <img src="/resources/assets/cargorapido.png" alt="Cargo Express">
          <div>
            <div class="conv-header-name">Cargo Rápido</div>
            <div class="conv-header-status">Online</div>
          </div>
        </div>

   
        <div id="chatArea">
          <div class="msg-received">
            <img src="/resources/assets/cargorapido.png" alt="">
            <div class="bubble bubble-received">
              <p>Hello! How are you?</p>
              <small class="bubble-time">9:55 am</small>
            </div>
          </div>
          <div class="msg-sent">
            <div class="bubble bubble-sent">
              <p>Everything's good! What about you?</p>
              <small class="bubble-time">9:56 am</small>
            </div>
          </div>
        </div>

    
        <div class="typing-indicator" id="typingIndicator">
          <img src="/resources/assets/cargorapido.png" alt="" style="width:32px;height:32px;border-radius:50%;object-fit:cover;border:1px solid rgba(65,130,180,0.4)">
          <div class="typing-bubble">
            <div class="typing-dot"></div>
            <div class="typing-dot"></div>
            <div class="typing-dot"></div>
          </div>
        </div>


        <div class="input-area">
          <input id="messageInput" type="text" placeholder="Type a message...">
          <button id="sendBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  const chatArea = document.getElementById('chatArea');
  const messageInput = document.getElementById('messageInput');
  const sendBtn = document.getElementById('sendBtn');
  const typingIndicator = document.getElementById('typingIndicator');

  function getNow() {
    return new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
  }

  function enviarMensaje(texto) {
    const msgDiv = document.createElement('div');
    msgDiv.className = "msg-sent";
    msgDiv.innerHTML = `
      <div class="bubble bubble-sent">
        <p>${texto}</p>
        <small class="bubble-time">${getNow()}</small>
      </div>
    `;
    chatArea.appendChild(msgDiv);
    chatArea.scrollTop = chatArea.scrollHeight;
  }

  function mostrarTyping() {
    typingIndicator.classList.add('show');
    chatArea.scrollTop = chatArea.scrollHeight;
  }

  function ocultarTyping() {
    typingIndicator.classList.remove('show');
  }

  function respuestaAutomatica(userText) {
    let respuesta = "Thank you for your message! 😊";

    if (userText.toLowerCase().includes("Ok, I will be waiting for it.")) {
      respuesta = "Ok then! I will let you know when I'm outside";
    } else if (userText.toLowerCase().includes("Are you close?")) {
      respuesta = "Yes, I'm two blocks away from my destination!";
    }

    mostrarTyping();

    setTimeout(() => {
      ocultarTyping();
      const replyDiv = document.createElement('div');
      replyDiv.className = "msg-received";
      replyDiv.innerHTML = `
        <img src="/resources/assets/cargorapido.png" style="width:32px;height:32px;border-radius:50%;object-fit:cover;border:1px solid rgba(65,130,180,0.4)">
        <div class="bubble bubble-received">
          <p>${respuesta}</p>
          <small class="bubble-time">${getNow()}</small>
        </div>
      `;
      chatArea.appendChild(replyDiv);
      chatArea.scrollTop = chatArea.scrollHeight;
    }, 1500);
  }

  sendBtn.addEventListener('click', () => {
    const text = messageInput.value.trim();
    if (text !== "") {
      enviarMensaje(text);
      messageInput.value = "";
      setTimeout(() => respuestaAutomatica(text), 300);
    }
  });

  messageInput.addEventListener("keypress", (e) => {
    if (e.key === "Enter") sendBtn.click();
  });
</script>

@end
