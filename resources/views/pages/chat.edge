                        <span
                            class="absolute bottom-1 right-1 bg-green-500 w-4 h-4 rounded-full border-2 border-blue-200"></span>
                    </div>
                    <small class="mt-2 font-bold text-gray-700 font-semibold">Cargo Express</small>
