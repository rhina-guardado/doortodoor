<script>
  const carrusel = document.getElementById('carrusel');
  const previo = document.getElementById('previo');
  const next = document.getElementById('next');
  const scrollAmount = 400;

  next.addEventListener('click', () => {
    carrusel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
  });

  previo.addEventListener('click', () => {
    carrusel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
  });
</script>

<script>
  const carrusel2 = document.getElementById('carrusel2');
  const previo2 = document.getElementById('previo2');
  const next2 = document.getElementById('next2');
  const scrollAmount = 400;

  next2.addEventListener('click', () => {
    carrusel2.scrollBy({ left: scrollAmount, behavior: 'smooth' });
  });

  previo2.addEventListener('click', () => {
    carrusel2.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
  });
</script>

