@layout()

<div class="relative bg-[#12254A] min-h-screen w-full overflow-y-auto">
  <video autoplay loop muted src="/resources/assets/video2background.mp4"
    class="fixed inset-0 w-full h-full object-cover z-0">
  </video>

  <nav
    class="absolute top-0 left-0 w-full z-50 flex justify-between items-center px-8 py-6 bg-gradient-to-r from-[#12254A]/20 via-[#0D4576]/20 to-[#12254A]/20">

    <a href="/" class="flex items-center">
      <img src="resources\assets\solo_to.png" alt="Logo doortodoor"
        class="h-18 w-auto object-contain hover:scale-105 transition-duration-400">
    </a>

    <a href="home.com" target="_blank"
      class=" drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)] hover:underline hover:text-white">Home</a>

    <div class="relative group">
      <button
        class="flex items-center gap-2 text-white bg-white/10 backdrop-blur-md px-5 py-2 rounded-full border border-white/20 hover:bg-white/20 transition-all active:scale-95">
        <span class="font-medium">Menu</span>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <div
        class="absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-[60] overflow-hidden py-2 border border-white/20">
        <a href="todavia no esta"
          class="block px-4 py-2.5 text-sm text-slate-800 hover:bg-[#12254A] hover:text-white transition-colors">Your
          profile</a>
        <a href="todavia no esta"
          class="block px-4 py-2.5 text-sm text-slate-800 hover:bg-[#12254A] hover:text-white transition-colors">Settings</a>
        <div class="h-[1px] bg-slate-200 my-1"></div>
        <a href="tampoco se puede"
          class="block px-4 py-2.5 text-sm text-red-600 hover:bg-red-500  hover:text-white transition-colors">Sign
          out</a>
      </div>
    </div>
  </nav>

  <main class="relative z-10 h-screen flex flex-col items-center justify-center text-center px-4">
    <h1
      class="text-white text-7xl md:text-9xl font-extrabold tracking-tighter drop-shadow-[0_0_10px_rgba(255,255,255,0.8)] font-header">
      Welcome
    </h1>
    <p class="text-white text-xl md:text-3xl mt-6 max-w-2xl font-light tracking-wide italic">
      Bring a piece of El Salvador to you<span class="font-bold text-[#4182b4]">+</span>
    </p>
  </main>

  <section class="relative z-10 px-8">
    <div class="max-w-4xl mx-auto text-center">
      <h2
        class="text-white text-4xl md:text-5xl font-bold tracking-tight tracking-tighter drop-shadow-[0_0_10px_rgba(255,255,255,0.8)]">
        With which agency do you wish to send your parcel today?
      </h2>
      <div
        class="mt-6 h-1 w-130 mx-auto rounded-full bg-linear-to-r from-[#4182B4] to-[#0D4576] drop-shadow-[0_0_8px_#4182b4]">
      </div>
    </div>

</div>
</section>

<section class="relative z-10 min-h-screen flex flex-col items-center justify-center">

