@layout() 
    <body>
<div class="relative bg-[#12254A] min-h-screen w-full overflow-y-auto">
  <video autoplay loop muted src="/resources/assets/video2background.mp4"
    class="fixed inset-0 w-full h-full object-cover z-0">
  </video>

<div class="flex">
  <section class="m-40">
<div
          class="agency-card flex flex-col items-center border p-4 border-sky-600 hover:shadow-[0_0_25px_20px_#1D4D92] transition-transform hover:scale-102 rounded-xl bg-[#083D8A] w-80 shadow-lg">
          <div class="relative">
            <img src="resources/assets/cargorapido.png"
              class="h-40 w-auto mx-auto object-contain mb-4 border rounded-3xl">
            <div class="absolute top-2 right-3 transition-transform hover:scale-120">
           
            </div>
          </div>
          <h1 class="text-center text-white font-bold text-2xl">Monthly</h1>
          <p class="text-center text-white text-sm my-4"></p>
          <div class="flex flex-col gap-1 items-center text-white border border-white/20 rounded-xl p-4 shadow-[inset_0_6px_6px_rgba(0,0,0,0.25)] w-60">
            <p class="drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)]">✓ Real-time tracking</p>
            <p class="drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)]">✓ Insurance included</p>
            <p class="drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)]">✓ Physical offices</p>
          </div>
          <button
            class="border rounded-full w-42 h-10 bg-gradient-to-r from-[#4182B4] via-[#2467A2] to-[#0D4576] cursor-pointer hover:from-[#2467A2] hover:via-[#4182B4] hover:to-[#2467A2] transition-all duration-300 m-4">
            <p class="drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)] hover:drop-shadow-[0_0_2px_#fff] btn-pupusa text-white">Select agency</p>
          </button>
        </div>
  </section>

  <section class="my-40">
<div
          class="agency-card flex flex-col items-center border p-4 border-sky-600 hover:shadow-[0_0_25px_20px_#1D4D92] transition-transform hover:scale-102 rounded-xl bg-[#083D8A] w-80 shadow-lg">
          <div class="relative">
            <img src="resources/assets/cargorapido.png"
              class="h-40 w-auto mx-auto object-contain mb-4 border rounded-3xl">
            <div class="absolute top-2 right-3 transition-transform hover:scale-120">
           
            </div>
          </div>
          <h1 class="text-center text-white font-bold text-2xl">Cargo Rápido</h1>
          <p class="text-center text-white text-sm my-4">Send it through established and reliable agencies with physical offices.</p>
          <div class="flex flex-col gap-1 items-center text-white border border-white/20 rounded-xl p-4 shadow-[inset_0_6px_6px_rgba(0,0,0,0.25)] w-60">
            <p class="drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)]">✓ Real-time tracking</p>
            <p class="drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)]">✓ Insurance included</p>
            <p class="drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)]">✓ Physical offices</p>
          </div>
          <button
            class="border rounded-full w-42 h-10 bg-gradient-to-r from-[#4182B4] via-[#2467A2] to-[#0D4576] cursor-pointer hover:from-[#2467A2] hover:via-[#4182B4] hover:to-[#2467A2] transition-all duration-300 m-4">
            <p class="drop-shadow-[0_1px_3px_rgba(255,255,255,0.5)] hover:drop-shadow-[0_0_2px_#fff] btn-pupusa text-white">Select agency</p>
          </button>
        </div>
  </section>
  </div>
    </body>
@end