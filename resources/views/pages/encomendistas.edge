                  <span>(465 reviews)</span>
                </button>
              </div>

              <div class="flex flex-row p-2 items-center gap-1">
                <span class="material-symbols-outlined">package_2</span>
                <p class="text-white">+586,564</p>
              </div>
            </div>


            <div class="h-[1px] bg-white/10 w-full px-2"></div>


            <div class="text-center pb-2 pt-1">
