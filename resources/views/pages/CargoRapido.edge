@layout()

<div class="relative bg-[#12254A] min-h-screen w-full overflow-y-auto">
  <video autoplay loop muted src="/resources/assets/video2background.mp4"
    class="fixed inset-0 w-full h-full object-cover z-0">
  </video>

  <nav class="absolute top-0 left-0 w-full z-50 flex justify-between items-center px-8 py-6 bg-transparent">

    <a href="/" class="flex items-center">
      <img src="resources\assets\solo_to.png" alt="Logo doortodoor"
        class="h-18 w-auto object-contain hover:scale-105 transition-duration-400">
    </a>

    <div class="relative group">
      <button
        class="flex items-center gap-2 text-white bg-white/10 backdrop-blur-md px-5 py-2 rounded-full border border-white/20 hover:bg-white/20 transition-all active:scale-95">
        <span class="font-medium">Menu</span>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <div
        class="absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-[60] overflow-hidden py-2 border border-white/20">
        <a href="profile"
          class="block px-4 py-2.5 text-sm text-slate-800 hover:bg-[#12254A] hover:text-white transition-colors">Your
          profile</a>
        <a href="todavia no esta"
          class="block px-4 py-2.5 text-sm text-slate-800 hover:bg-[#12254A] hover:text-white transition-colors">Settings</a>
        <div class="h-[1px] bg-slate-200 my-1"></div>
        <a href="tampoco se puede"
          class="block px-4 py-2.5 text-sm text-red-600 hover:bg-red-500  hover:text-white transition-colors">Sign
          out</a>
      </div>
    </div>
  </nav>

  <section class="relative z-10 min-h-screen  text-white p-8 font-sans">

    <div class="max-w-6xl pt-36 mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-start">


      <div class="space-y-12">

        <div class="space-y-4">
          <h2 class="text-3xl font-bold">Location</h2>
          <p class="text-gray-300 text-sm leading-relaxed">
            The company is located at 91st North Avenue, Building #327, Escalón, San Salvador.
          </p>
        </div>


        <div class="relative group w-full">
          <div class="-inset-1 rounded-lg blur opacity-75"></div>
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15504.67407330174!2d-89.25315476716787!3d13.708241383485259!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f63301ec4aaa4c1%3A0x67bf47eb58044d83!2sEl%20Escal%C3%B3n%2C%20San%20Salvador!5e0!3m2!1ses-419!2ssv!4v1778598934073!5m2!1ses-419!2ssv"
            width="550" height="450" style="border:0;" allowfullscreen="" loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>

        <div class="space-y-4">
          <h2 class="text-3xl font-bold">Coverage</h2>
          <p class="text-gray-300 text-sm leading-relaxed">
            It offers a basic coverage of up to $100 USD at no extra cost for most national and international shipments.
            There is limited liability coverage for selected services, and you can also buy extra insurance that covers
            more than 220 countries and regions, including North America, Europe, Asia-Pacific, Latin America, the
            Middle East, and Africa.
          </p>
        </div>


        <div class="space-y-4">
          <h2 class="text-3xl font-bold">Prices</h2>
          <p class="text-gray-300 text-sm leading-relaxed">
            Prices may very depending on the weight, size, and type of shipment, so these details are needed to get a
            quote.
          </p>
        </div>
      </div>


      <div class="flex flex-col items-center">

        <div class="relative mb-6">

          <div class="relative mb-6">
            <div class="absolute -inset-4 bg-blue-600/40 rounded-[2rem] blur-xl"></div>

            <div
              class="relative overflow-hidden rounded-[2rem] border border-blue-400/30 w-80resources/views/pages/ConectExpress.edge h-48 flex items-center justify-center bg-[#4a2418]">
              <img src="resources\assets\cargorapido.png" alt="CargoRapido" class="w-full h-full object-cover">
            </div>
          </div>
        </div>

        <h1 class="text-5xl font-black mb-8 tracking-tighter">Cargo Rápido</h1>


        <div class="flex gap-12 mb-12">
          <button
            class="px-10 py-1 bg-[#1d3557] rounded-full border border-blue-400/50 text-xs hover:bg-blue-900 transition-colors">Chat</button>
          <button
            class="px-10 py-1 bg-[#1d3557] rounded-full border border-blue-400/50 text-xs hover:bg-blue-900 transition-colors">Track</button>
        </div>


        <div class="relative w-full pl-8 border-l-2 border-gray-600 space-y-10">


          <div class="relative">
            <div class="absolute -left-[41px] top-1 w-4 h-4 bg-purple-600 rounded-full border-4 border-[#0a192f]"></div>
            <h3 class="text-2xl font-bold mb-2">Services</h3>
            <p class="text-gray-300 text-sm">It offers national and international parcel delivery services, including
              express and guaranteed-time deliveries...</p>
          </div>


          <div class="relative">
            <div class="absolute -left-[41px] top-1 w-4 h-4 bg-purple-600 rounded-full border-4 border-[#0a192f]"></div>
            <h3 class="text-2xl font-bold mb-2">Schedule</h3>
            <p class="text-gray-300 text-sm">Monday to Friday: 8:00 a.m. - 6:00 p.m.<br>Saturday: 9:00 a.m. - 12:00
              p.m.<br>Sunday: Closed</p>
          </div>


          <div class="relative">
            <div class="absolute -left-[41px] top-1 w-4 h-4 bg-purple-600 rounded-full border-4 border-[#0a192f]"></div>
            <h3 class="text-2xl font-bold mb-2">Phone</h3>
            <p class="text-gray-300 text-sm">(+503) 2248 - 8988</p>
          </div>

          <div class="relative">
            <div class="absolute -left-[41px] top-1 w-4 h-4 bg-purple-600 rounded-full border-4 border-[#0a192f]"></div>
            <h3 class="text-2xl font-bold mb-2">Website</h3>
            <a href="#" class="text-blue-400 text-xs underline break-all">https://www.ups.com/sv/es/home</a>
          </div>
        </div>
      </div>
    </div>

    <section class="relative z-10 py-16 px-8 text-white font-sans">
      <div class="max-w-6xl mx-auto">

        <h2 class="text-4xl font-bold text-center mb-16 tracking-tight">Products</h2>


        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">


          <div class="border border-white/20 rounded-lg overflow-hidden bg-white/5 backdrop-blur-sm min-h-[400px]">

            <div class="bg-gradient-to-b from-[#1D4D92]/50 to-transparent py-8 border-b border-white/10">
              <h3 class="text-xl font-bold text-center tracking-wide">Allowed</h3>
            </div>

            <div class="p-8 space-y-2 text-center">
              <p class="text-lg text-gray-200">Clothes</p>
              <p class="text-lg text-gray-200">Electronics</p>
              <p class="text-lg text-gray-200">Documents</p>
              <p class="text-lg text-gray-200">Manufactured items</p>
            </div>
          </div>


          <div class="border border-white/20 rounded-lg overflow-hidden bg-white/5 backdrop-blur-sm min-h-[400px]">

            <div class="bg-gradient-to-b from-[#1D4D92]/50 to-transparent py-8 border-b border-white/10">
              <h3 class="text-xl font-bold text-center tracking-wide">Not Allowed</h3>
            </div>

            <div class="p-8 space-y-2 text-center">
              <p class="text-lg text-gray-200">Perishable food</p>
              <p class="text-lg text-gray-200">Alcoholic beverages</p>
              <p class="text-lg text-gray-200">Weapons</p>
              <p class="text-lg text-gray-200">Dangerous materials</p>
              <p class="text-lg text-gray-200">Products from protected species</p>
              <p class="text-lg text-gray-200">Medicines without permits</p>
              <p class="text-lg text-gray-200">Items with special documentation</p>
            </div>
          </div>

        </div>


        <div class="mt-16 text-center">
          <p class="text-gray-400 text-sm italic">
            Note: Please check permits and documentation to avoid issues at customs.
          </p>
        </div>
      </div>
    </section>
  </section>













  <footer class="relative z-10 w-full bg-white/5 backdrop-blur-xl border-t border-white/10 pt-12 pb-8 px-8 mt-20">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">

        <div class="col-span-1 md:col-span-1">
          <img src="resources/assets/solo_to.png" alt="Logo" class="h-12 w-auto mb-6 opacity-90">
          <p class="text-white/60 text-sm leading-relaxed">
            Connecting El Salvador with the world, one parcel at a time. The most reliable way to bring a piece of home
            to
            you.
          </p>
        </div>

        <div>
          <h4 class="text-white font-bold mb-6 tracking-wider uppercase text-xs">Quick Links</h4>
          <ul class="space-y-4">
            <li><a href=nohay class="text-white/50 hover:text-[#4182b4] transition-colors text-sm">Home</a></li>
            <li><a href=nohay class="text-white/50 hover:text-[#4182b4] transition-colors text-sm">Agencies</a></li>
            <li><a href=nohay class="text-white/50 hover:text-[#4182b4] transition-colors text-sm">How it works</a></li>
            <li><a href=nohay class="text-white/50 hover:text-[#4182b4] transition-colors text-sm">Tracking</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-white font-bold mb-6 tracking-wider uppercase text-xs">Support</h4>
          <ul class="space-y-4">
            <li><a href=nohay class="text-white/50 hover:text-[#4182b4] transition-colors text-sm">Help Center</a></li>
            <li><a href=nohay class="text-white/50 hover:text-[#4182b4] transition-colors text-sm">Terms of Service</a>
            </li>
            <li><a href=nohay class="text-white/50 hover:text-[#4182b4] transition-colors text-sm">Privacy Policy</a>
            </li>
            <li><a href=nohay class="text-white/50 hover:text-[#4182b4] transition-colors text-sm">Contact Us</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-white font-bold mb-6 tracking-wider uppercase text-xs">Stay Connected</h4>
          <div class="flex gap-4">
            <a href=nohay class="bg-white/10 p-2 rounded-lg hover:bg-[#4182b4] transition-all text-white">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z" />
              </svg>
            </a>
            <a href=nohay class="bg-white/10 p-2 rounded-lg hover:bg-[#4182b4] transition-all text-white">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
              </svg>
            </a>
            <a href=nohay class="bg-white/10 p-2 rounded-lg hover:bg-[#4182b4] transition-all text-white">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div class="border-t border-white/5 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-white/30 text-xs text-center md:text-left">
          &copy; 2026 Door to Door El Salvador. All rights reserved.
        </p>
        <div class="flex items-center gap-6">
          <span class="text-white/30 text-xs flex items-center gap-2 italic">
            <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
            Systems Operational
          </span>
        </div>
      </div>
    </div>
  </footer>


  @end
